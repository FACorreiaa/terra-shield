{
  "$comment": "Aegis Terra design tokens: the one source for every client (DESIGN.md). Schema follows apps/aaru/design/tokens.json so S3.1 can copy aaru/scripts/generate-tokens.mjs. That generator writes Tokens.gen.swift + Apple colour sets + web tokens.css, and fails when a pair in contrastPairs is under its minimum. Never put hex in a view; add a token here instead. The MVP is dark-only: `light` is null until a light theme is designed.",
  "version": 1,
  "colors": {
    "canvas": {
      "note": "Deep-space navy. App and window background, the frame around the map. Never pure black.",
      "dark": "#080E1A",
      "light": null,
      "apple": ["Canvas"]
    },
    "panel": {
      "note": "Graphite-navy panels: sheet, sidebar, inspector, cards.",
      "dark": "#111C2D",
      "light": null,
      "apple": ["Panel"]
    },
    "raised": {
      "note": "Slate. Raised rows, selected sidebar item, chip fills, matrix cells. Not a text colour.",
      "dark": "#203550",
      "light": null,
      "apple": ["Raised"]
    },
    "ink": {
      "note": "Primary text and strong glyphs.",
      "dark": "#E8EEF6",
      "light": null,
      "apple": ["Ink"]
    },
    "muted": {
      "note": "Secondary text: metadata, timestamps, source names, captions.",
      "dark": "#9AABC2",
      "light": null,
      "apple": ["Muted"]
    },
    "faint": {
      "note": "Tertiary: placeholder, disabled, axis ticks. Never the only carrier of meaning.",
      "dark": "#6F819A",
      "light": null,
      "apple": ["Faint"]
    },
    "hairline": {
      "note": "1 px borders and dividers. Solid equivalent of ink at ~10% over panel, for places alpha cannot be used.",
      "dark": "#24324A",
      "light": null,
      "apple": ["Hairline"]
    },
    "accent": {
      "note": "Electric blue. Information, links, selection, focus ring, the user's own location, primary buttons. Never a severity.",
      "dark": "#52B6FF",
      "light": null,
      "apple": ["AccentColor"]
    },
    "on-accent": {
      "note": "Text and glyphs on an accent fill. Navy, never white (white on #52B6FF is 2.3:1).",
      "dark": "#080E1A",
      "light": null,
      "apple": ["OnAccent"]
    },
    "warning": {
      "note": "Amber. UI warnings that are not hazards: stale data, limited coverage, offline. Same hue as severity.moderate on purpose; always paired with an icon + words.",
      "dark": "#FFB54A",
      "light": null,
      "apple": ["Warning"]
    },
    "danger": {
      "note": "Disaster red. UI errors and destructive actions. Same hue as severity.extreme; use it for nothing decorative.",
      "dark": "#F35D62",
      "light": null,
      "apple": ["Danger"]
    },
    "ok": {
      "note": "Quiet green. Only for source health 'up to date' dots and 'Resolved' status. Never on the map.",
      "dark": "#4FD1A1",
      "light": null,
      "apple": ["Ok"]
    }
  },
  "brand": {
    "$comment": "Logo and Sentinel mascot colours from the asset pack (design/brand/source/design-tokens.json). For brand art, onboarding and marketing only. Never a UI state, never a severity, never text.",
    "energy-cyan": "#00E9FF",
    "alert-red": "#FF2D3D",
    "armor-silver": "#C9CDD4",
    "graphite": "#2B2F36"
  },
  "severity": {
    "$comment": "App severity (CAP-aligned, derived in backend internal/severity). Colour is never alone: every use carries the glyph shape and the word. Source severity (GDACS green/orange/red, Meteoalarm level, USGS mag/PAGER) is printed verbatim next to it in muted text and is never recoloured.",
    "minor": {
      "label": "Minor",
      "dark": "#8DA2BE",
      "shape": "circle",
      "sfSymbol": "circle.fill",
      "markerScale": 0.8,
      "apple": ["SeverityMinor"]
    },
    "moderate": {
      "label": "Moderate",
      "dark": "#FFB54A",
      "shape": "diamond",
      "sfSymbol": "diamond.fill",
      "markerScale": 1.0,
      "apple": ["SeverityModerate"]
    },
    "severe": {
      "label": "Severe",
      "dark": "#FF8540",
      "shape": "triangle",
      "sfSymbol": "triangle.fill",
      "markerScale": 1.15,
      "apple": ["SeveritySevere"]
    },
    "extreme": {
      "label": "Extreme",
      "dark": "#F35D62",
      "shape": "octagon",
      "sfSymbol": "exclamationmark.octagon.fill",
      "markerScale": 1.3,
      "pulse": true,
      "apple": ["SeverityExtreme"]
    }
  },
  "kind": {
    "$comment": "Backend `kind` on every record (DECISIONS #3). Kind changes the marker's form, never its colour; colour belongs to severity.",
    "observed": {
      "label": "Observed",
      "marker": "filled",
      "area": "fill 18% + solid 1.5 px stroke",
      "sfSymbol": "eye",
      "chip": "neutral"
    },
    "warning": {
      "label": "Official warning",
      "marker": "filled with 2 px canvas-coloured ring",
      "area": "fill 10% + solid 2 px stroke",
      "sfSymbol": "checkmark.seal",
      "chip": "neutral, seal icon"
    },
    "forecast": {
      "label": "Forecast",
      "marker": "outlined (stroke only)",
      "area": "no fill + dashed 1.5 px stroke [6,4]",
      "sfSymbol": "clock.arrow.circlepath",
      "chip": "neutral, dashed border"
    },
    "detection": {
      "label": "Satellite heat detection",
      "marker": "3-6 px dot in colors.detection, no glyph, never clustered into hazard clusters",
      "area": "none",
      "sfSymbol": "thermometer.high",
      "chip": "neutral",
      "dark": "#F7D774",
      "apple": ["Detection"],
      "never": "Never labelled 'wildfire'. A FIRMS hotspot is a detection, not a confirmed fire."
    }
  },
  "hazardType": {
    "$comment": "Backend `type` enum (ARCHITECTURE §3) to icons. Apple targets iOS 18 / macOS 15, so SF Symbols 6 names; verify each in the SF Symbols app at S3.2. webIcon = Lucide name, verify at Phase 2.",
    "earthquake":       { "label": "Earthquake",        "sfSymbol": "waveform.path.ecg",                      "webIcon": "activity" },
    "wildfire":         { "label": "Wildfire",          "sfSymbol": "flame.fill",                             "webIcon": "flame" },
    "flood":            { "label": "Flood",             "sfSymbol": "water.waves",                            "webIcon": "waves" },
    "storm":            { "label": "Storm",             "sfSymbol": "cloud.bolt.rain.fill",                   "webIcon": "cloud-lightning" },
    "tropical_cyclone": { "label": "Tropical cyclone",  "sfSymbol": "hurricane",                              "webIcon": "tornado" },
    "volcano":          { "label": "Volcano",           "sfSymbol": "mountain.2.fill",                        "webIcon": "mountain" },
    "drought":          { "label": "Drought",           "sfSymbol": "sun.dust.fill",                          "webIcon": "sun-dim" },
    "heat":             { "label": "Extreme heat",      "sfSymbol": "thermometer.sun.fill",                   "webIcon": "thermometer-sun" },
    "cold":             { "label": "Extreme cold",      "sfSymbol": "thermometer.snowflake",                  "webIcon": "thermometer-snowflake" },
    "heavy_rain":       { "label": "Heavy rain",        "sfSymbol": "cloud.heavyrain.fill",                   "webIcon": "cloud-rain" },
    "wind":             { "label": "Wind",              "sfSymbol": "wind",                                   "webIcon": "wind" },
    "snow_ice":         { "label": "Snow and ice",      "sfSymbol": "snowflake",                              "webIcon": "snowflake" },
    "tsunami":          { "label": "Tsunami",           "sfSymbol": "water.waves.and.arrow.trianglehead.up",  "webIcon": "waves-arrow-up" },
    "other":            { "label": "Other hazard",      "sfSymbol": "exclamationmark.triangle.fill",          "webIcon": "triangle-alert" }
  },
  "radius": {
    "$comment": "Small, precise corners. lg is the largest card radius anywhere; sheets use the system radius.",
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 18,
    "pill": 999
  },
  "space": {
    "$comment": "4-pt grid.",
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40
  },
  "type": {
    "$comment": "Apple: SF Pro via text styles so Dynamic Type works; numbers use .monospacedDigit(). Web: the system-ui stack; no bundled proprietary fonts. Sizes are the default (Large) content size.",
    "fontStack": {
      "apple": "SF Pro (system)",
      "appleMono": "SF Mono (system, .monospaced)",
      "web": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "webMono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    "scale": {
      "statHero":  { "size": 34, "weight": "semibold", "tracking": -0.4, "apple": "largeTitle",  "digits": "monospaced", "use": "Stat strip numbers, magnitude in the detail header" },
      "title":     { "size": 22, "weight": "semibold", "tracking": -0.2, "apple": "title2",      "use": "Sheet / inspector title, country name" },
      "headline":  { "size": 17, "weight": "semibold", "tracking": 0,    "apple": "headline",    "use": "Card and row titles" },
      "body":      { "size": 15, "weight": "regular",  "tracking": 0,    "apple": "subheadline", "use": "Summaries, prose" },
      "meta":      { "size": 13, "weight": "regular",  "tracking": 0,    "apple": "footnote",    "digits": "monospaced", "use": "Source, time, coordinates" },
      "micro":     { "size": 11, "weight": "semibold", "tracking": 0.9,  "apple": "caption2",    "case": "uppercase", "use": "Section labels: 'EARTH / MONITOR', 'SOURCE', 'TIMELINE'. Sparingly." }
    }
  },
  "alpha": {
    "hairline": 0.08,
    "hairlineStrong": 0.14,
    "areaFillObserved": 0.18,
    "areaFillWarning": 0.10,
    "stale": 0.45,
    "scrim": 0.60,
    "pressed": 0.85
  },
  "material": {
    "$comment": "Translucency only where something floats over the map. Never stacked.",
    "floating": { "apple": ".ultraThinMaterial + canvas tint 40%", "web": "background: rgb(17 28 45 / 0.72); backdrop-filter: blur(20px) saturate(140%)" },
    "sheet":    { "apple": ".regularMaterial over map, panel colour when fully expanded", "web": "panel" }
  },
  "elevation": {
    "floating": { "y": 8, "blur": 24, "color": "#000000", "opacity": 0.35 },
    "marker":   { "y": 1, "blur": 3,  "color": "#000000", "opacity": 0.5 }
  },
  "motion": {
    "$comment": "All motion is off or replaced by a cross-fade under Reduce Motion.",
    "spring":       { "response": 0.35, "dampingFraction": 0.86, "use": "Sheet detents, inspector, chip toggles" },
    "fast":         { "ms": 150, "easing": "easeOut", "use": "Hover, press, selection" },
    "standard":     { "ms": 240, "easing": "easeInOut", "use": "Cluster split/merge, filter changes" },
    "arrive":       { "ms": 400, "easing": "easeOut", "use": "New event fades + scales from 0.6 on SSE event.created" },
    "extremePulse": { "ms": 1800, "repeat": true, "use": "Extreme-severity marker halo only; one ring, max 2.2x, opacity 0.5 to 0" }
  },
  "contrastPairs": [
    { "fg": "ink",        "bg": "canvas",  "min": 4.5 },
    { "fg": "ink",        "bg": "panel",   "min": 4.5 },
    { "fg": "ink",        "bg": "raised",  "min": 4.5 },
    { "fg": "muted",      "bg": "canvas",  "min": 4.5 },
    { "fg": "muted",      "bg": "panel",   "min": 4.5 },
    { "fg": "muted",      "bg": "raised",  "min": 4.5 },
    { "fg": "faint",      "bg": "panel",   "min": 3.0 },
    { "fg": "accent",     "bg": "canvas",  "min": 4.5 },
    { "fg": "accent",     "bg": "panel",   "min": 4.5 },
    { "fg": "on-accent",  "bg": "accent",  "min": 4.5 },
    { "fg": "warning",    "bg": "panel",   "min": 4.5 },
    { "fg": "danger",     "bg": "panel",   "min": 4.5 },
    { "fg": "ok",         "bg": "panel",   "min": 4.5 },
    { "fg": "severity.minor",    "bg": "canvas", "min": 3.0 },
    { "fg": "severity.moderate", "bg": "canvas", "min": 3.0 },
    { "fg": "severity.severe",   "bg": "canvas", "min": 3.0 },
    { "fg": "severity.extreme",  "bg": "canvas", "min": 3.0 },
    { "fg": "severity.minor",    "bg": "panel",  "min": 4.5 },
    { "fg": "severity.moderate", "bg": "panel",  "min": 4.5 },
    { "fg": "severity.severe",   "bg": "panel",  "min": 4.5 },
    { "fg": "severity.extreme",  "bg": "panel",  "min": 4.5 },
    { "fg": "canvas",            "bg": "severity.moderate", "min": 4.5, "note": "text on a severity badge fill is canvas navy, never white" },
    { "fg": "canvas",            "bg": "severity.severe",   "min": 4.5 },
    { "fg": "canvas",            "bg": "severity.extreme",  "min": 4.5 },
    { "fg": "kind.detection",    "bg": "canvas", "min": 3.0 }
  ]
}
